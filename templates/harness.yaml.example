version: 1

# Primary language for this harness is Ruby.
# Copy to .cursor/harness.yaml and keep that copy untracked.
# If the repo uses Minitest instead of RSpec, change the test gate to
# `bundle exec rake test`. Add another codebase only when that stack is present.

codebases:
  application:
    roots:
      - .
    languages:
      - ruby
    context:
      - CLAUDE.md
      - .memory-bank/ruby/architecture.md
      - .memory-bank/ruby/testing.md
    gates:
      lint:
        - bundle exec rubocop
      test:
        - bundle exec rspec
